#!/usr/bin/env bash

set -euo pipefail

repository_root="$(git rev-parse --show-toplevel)"
cd "${repository_root}"

formatter="$(git config --get hooks.clangFormat || true)"
if [[ -z "${formatter}" ]]; then
    formatter="${CLANG_FORMAT:-clang-format}"
fi
if [[ "${formatter}" == */* ]]; then
    if [[ ! -x "${formatter}" ]]; then
        echo "pre-commit: clang-format is not executable: ${formatter}" >&2
        echo "Run scripts/install_git_hooks.sh /path/to/clang-format." >&2
        exit 1
    fi
else
    resolved_formatter="$(command -v "${formatter}" || true)"
    if [[ -z "${resolved_formatter}" ]]; then
        echo "pre-commit: clang-format was not found: ${formatter}" >&2
        echo "Run scripts/install_git_hooks.sh /path/to/clang-format." >&2
        exit 1
    fi
    formatter="${resolved_formatter}"
fi

mapfile -d '' -t staged_sources < <(
    git diff --cached --name-only --diff-filter=ACMR -z -- \
        '*.c' '*.cc' '*.cpp' '*.cxx' '*.h' '*.hh' '*.hpp' '*.hxx'
)

if (( ${#staged_sources[@]} == 0 )); then
    exit 0
fi

for path in "${staged_sources[@]}"; do
    if [[ -f "${path}" ]] && ! git diff --quiet -- "${path}"; then
        echo "pre-commit: ${path} contains unstaged changes." >&2
        echo "Stage or restore them before automatic formatting to avoid committing unintended content." >&2
        exit 1
    fi
done

existing_sources=()
for path in "${staged_sources[@]}"; do
    if [[ -f "${path}" ]]; then
        existing_sources+=("${path}")
    fi
done

if (( ${#existing_sources[@]} == 0 )); then
    exit 0
fi

"${formatter}" -i --style=file "${existing_sources[@]}"
git add -- "${existing_sources[@]}"
